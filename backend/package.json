{
  "name": "glazewave",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "nodemon ./bin/server.js",
    "prod": "pm2 start ./bin/server.js",
    "scaffold": "npm run create-db && npm run load-data",
    "create-db": "node bin/sql/createRecipesTable.js",
    "delete-db": "node bin/sql/deleteUsersTable.js",
    "load-data": "node bin/sql/loadRecipesTable.js",
    "sync-elastic": "node app/scripts/sync_elastic.js",
    "spots:probe": "node app/scripts/probe_spot_sources.js",
    "spots:seed-file": "node app/scripts/build_spot_seed.js",
    "sync-surfline": "node app/scripts/import_surfline.js",
    "test-queue": "node app/services/queue/BetterQueue.js",
    "test-elastic": "node app/scripts/elastic/test.js",
    "sequelize": "npx sequelize-cli --options-path=app/config/sequelize.js",
    "backfill-elastic": "node app/scripts/backfill_elastic.js",
    "boards:import": "node app/scripts/import_boards.js",
    "boards:makers": "node app/scripts/import_boards.js --report-makers",
    "boards:dry-run": "node app/scripts/import_boards.js --dry-run"
  },
  "dependencies": {
    "@elastic/elasticsearch": "~7.17.0",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.20.0",
    "better-queue": "^3.8.12",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "elastic-builder": "^2.7.1",
    "express": "^4.22.2",
    "generate-password": "^1.7.1",
    "jsonwebtoken": "^9.0.3",
    "jwk-to-pem": "^2.0.7",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "multer-sharp-s3": "^0.2.1",
    "mysql2": "^2.3.3",
    "node-cache": "^5.1.2",
    "sequelize": "^5.22.5",
    "wkx": "^0.5.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
