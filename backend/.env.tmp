AWS_ACCESS_KEY_ID=<Your Aws Access Key>
AWS_SECRET_ACCESS_KEY=B<Your AWS Secret Access Key>
AWS_S3_BUCKET=<Your S3 Bucket>
AWS_DEFAULT_REGION=us-east-1
AWS_COGNITO_USER_POOL=<Your cognito user pool id >
AWS_COGNITO_CLIENT_ID=<Your cognito client id >
AWS_DYNAMO_HOST=http://localhost:8000
API_HOST=http://localhost:3001
CLIENT_URL=http://localhost:3000
SERVER_PORT=3001

# Demo login. Both keys are base64 of a PEM, on one line: dotenv only keeps a
# multi-line value when it is double-quoted, and a systemd EnvironmentFile drops
# the newlines outright.
#   openssl genrsa -out demo.pem 2048
#   openssl rsa -in demo.pem -pubout -out demo.pub
#   base64 < demo.pem | tr -d '\n'
DEMO_ENABLED=0
DEMO_PUBLIC=0
DEMO_KEY=<shared secret for /api/demo/login?k=>
DEMO_USERNAME=demo
DEMO_JWT_PRIVATE_KEY=<base64 of demo.pem>
DEMO_JWT_PUBLIC_KEY=<base64 of demo.pub>
