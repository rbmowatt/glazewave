{
  "settings": {
    "number_of_replicas": 0,
    "analysis": {
      "filter": {
        "englishStopWords": {
          "type": "stop",
          "stopwords": "_english_"
        }
      },
      "analyzer": {
        "userBoardNameAnalyzer": {
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "englishStopWords"
          ]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "id": {
        "type": "integer"
      },
      "user_id": {
        "type": "integer"
      },
      "title": {
        "type": "keyword",
        "fields": {
          "analyzed": {
            "type": "text",
            "analyzer": "userBoardNameAnalyzer",
            "search_analyzer": "userBoardNameAnalyzer"
          }
        }
      },
      "notes": {
        "type": "text",
        "analyzer": "userBoardNameAnalyzer"
      },
      "session_date": {
        "type": "date"
      },
      "rating": {
        "type": "integer"
      },
      "is_public": {
        "type": "integer"
      },
      "location": {
        "type": "keyword",
        "fields": {
          "analyzed": {
            "type": "text",
            "analyzer": "userBoardNameAnalyzer",
            "search_analyzer": "userBoardNameAnalyzer"
          }
        }
      },
      "location_id": {
        "type": "keyword"
      },
      "location_point": {
        "type": "geo_point",
        "ignore_malformed": true
      },
      "board": {
        "type": "keyword",
        "fields": {
          "analyzed": {
            "type": "text",
            "analyzer": "userBoardNameAnalyzer",
            "search_analyzer": "userBoardNameAnalyzer"
          }
        }
      },
      "board_id": {
        "type": "integer"
      },
      "manufacturer": {
        "type": "keyword",
        "fields": {
          "analyzed": {
            "type": "text",
            "analyzer": "userBoardNameAnalyzer",
            "search_analyzer": "userBoardNameAnalyzer"
          }
        }
      },
      "model": {
        "type": "keyword",
        "fields": {
          "analyzed": {
            "type": "text",
            "analyzer": "userBoardNameAnalyzer",
            "search_analyzer": "userBoardNameAnalyzer"
          }
        }
      },
      "category": {
        "type": "keyword"
      },
      "board_length_in": {
        "type": "float"
      },
      "board_width_in": {
        "type": "float"
      },
      "board_thickness_in": {
        "type": "float"
      },
      "board_volume_l": {
        "type": "float"
      },
      "board_dims_source": {
        "type": "keyword"
      },
      "wave_height": {
        "type": "float"
      },
      "wave_period": {
        "type": "float"
      },
      "swell_height": {
        "type": "float"
      },
      "swell_period": {
        "type": "float"
      },
      "water_temperature": {
        "type": "float"
      },
      "wind_speed": {
        "type": "float"
      },
      "pressure": {
        "type": "float"
      }
    }
  }
}
