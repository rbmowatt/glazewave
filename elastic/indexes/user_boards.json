{
  "settings": {
    "number_of_replicas": 0,
    "analysis": {
      "filter": {
        "englishStopWords": {
          "type": "stop",
          "stopwords": "_english_"
        }
      },
      "analyzer": {
        "userBoardNameAnalyzer": {
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "englishStopWords"
          ]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "id": {
        "type": "integer"
      },
      "user_id": {
        "type": "integer"
      },
      "board_id": {
        "type": "integer"
      },
      "manufacturer_id": {
        "type": "integer"
      },
      "name": {
        "type": "keyword",
        "fields": {
          "analyzed": {
            "type": "text",
            "analyzer": "userBoardNameAnalyzer",
            "search_analyzer": "userBoardNameAnalyzer"
          }
        }
      },
      "model": {
        "type": "keyword",
        "fields": {
          "analyzed": {
            "type": "text",
            "analyzer": "userBoardNameAnalyzer",
            "search_analyzer": "userBoardNameAnalyzer"
          }
        }
      },
      "manufacturer": {
        "type": "keyword",
        "fields": {
          "analyzed": {
            "type": "text",
            "analyzer": "userBoardNameAnalyzer",
            "search_analyzer": "userBoardNameAnalyzer"
          }
        }
      },
      "notes": {
        "type": "text",
        "analyzer": "userBoardNameAnalyzer"
      },
      "size": {
        "type": "keyword"
      },
      "length_in": {
        "type": "float"
      },
      "width_in": {
        "type": "float"
      },
      "thickness_in": {
        "type": "float"
      },
      "volume_l": {
        "type": "float"
      },
      "dims_source": {
        "type": "keyword"
      },
      "category": {
        "type": "keyword"
      },
      "year_introduced": {
        "type": "short"
      },
      "rating": {
        "type": "integer"
      },
      "is_public": {
        "type": "integer"
      }
    }
  }
}
