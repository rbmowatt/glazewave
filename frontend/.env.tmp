REACT_APP_AWS_DEFAULT_REGION=<your default region>
REACT_APP_AWS_COGNITO_USER_POOL=< your user pool >
REACT_APP_AWS_COGNITO_USER_POOL_BASE_URI=<user pool base>
REACT_APP_AWS_COGNITO_CLIENT_ID=< gognito client id>
REACT_APP_AWS_COGNITO_CALLBACK_URI=http://localhost:3000/login
REACT_APP_AWS_COGNITO_SIGNOUT_URI=http://localhost:3000/logout
REACT_APP_API_HOST=http://localhost:3001
REACT_APP_API_BASE=http://localhost
REACT_APP_API_PORT=:3001

# Shows the demo button. Inlined at build time, so changing it needs a rebuild
# and a committed frontend/build - it is not the same switch as the backend's
# runtime DEMO_PUBLIC, and the two can disagree.
REACT_APP_DEMO_PUBLIC=0
