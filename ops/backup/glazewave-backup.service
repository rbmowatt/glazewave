[Unit]
Description=Back up the surfbook database to S3
After=network-online.target mysqld.service
Wants=network-online.target
OnFailure=glazewave-alert@%n.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/glazewave/backup.env
ExecStart=/usr/local/bin/glazewave-backup.sh
# The dump competes with Elasticsearch and MySQL for 2GB. Niced so a slow
# backup stays slow instead of pushing the API into swap.
Nice=10
IOSchedulingClass=idle
